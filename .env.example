# Valeurs lues par Docker Compose. Copier ce fichier vers .env pour les modifier.
POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub
POSTGRES_PORT=5432

# Générer une valeur avec : openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-local-admin-password
